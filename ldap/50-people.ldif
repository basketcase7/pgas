# Заглушка корпоративного каталога R-09 (LDAP/AD).
# Каталог — источник истины о статусе обучающегося: employeeType
#   student-active   — действующий обучающийся (может подавать заявки);
#   student-expelled — отчислен (OP-02 → 403);
#   staff            — сотрудник.
# departmentNumber — код подразделения (units.code). Паролей в каталоге нет:
# аутентификация выполняется auth-service по Argon2id-хешу в БД.

dn: ou=people,dc=spbstu,dc=local
objectClass: organizationalUnit
ou: people

dn: uid=stud001,ou=people,dc=spbstu,dc=local
objectClass: inetOrgPerson
uid: stud001
cn: Иванов Иван Иванович
sn: Иванов
mail: stud001@example.edu
employeeType: student-active
departmentNumber: ICST

