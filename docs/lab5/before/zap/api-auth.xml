									<evidence>no-store</evidence>
									<otherinfo></otherinfo>
								</instance>
							
							
								<instance>
									<uri>https://api-gateway:8443/api/v1/auth/password-reset</uri>
									<nodeName>https://api-gateway:8443/api/v1/auth/password-reset ()({email})</nodeName>
