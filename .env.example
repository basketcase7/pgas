# =====================================================================
#  Переменные окружения системы. Значения НЕ хранятся в репозитории.
#  Скопируйте файл в .env и заполните, либо выполните scripts/gen-env.sh —
#  он сгенерирует случайные значения, ключи подписи и TLS-сертификат шлюза.
# =====================================================================

# ---------- PostgreSQL (B-05) ----------
# Пароль суперпользователя postgres. Используется ТОЛЬКО контейнером liquibase
# для применения миграций; прикладные сервисы под postgres не подключаются.
POSTGRES_PASSWORD=
# Пароли отдельных ролей сервисов (п. 3.5 ЛР2, roles.sql). У каждого сервиса своя роль.
SVC_AUTH_DB_PASSWORD=
SVC_APPLICATIONS_DB_PASSWORD=
SVC_REVIEW_DB_PASSWORD=

# ---------- Redis (B-06): у каждого клиента свой ACL-пользователь и префикс ключей ----------
REDIS_GATEWAY_PASSWORD=
REDIS_AUTH_PASSWORD=
REDIS_APPLICATIONS_PASSWORD=
REDIS_REVIEW_PASSWORD=
REDIS_NOTIFIER_PASSWORD=

# ---------- Kafka (B-08/B-09): SASL/PLAIN, права на топики выдаются ACL ----------
# Административная учётная запись: создание топиков и ACL (kafka-init), kafka-ui.
KAFKA_ADMIN_PASSWORD=
# Учётные записи сервисов-производителей и потребителя.
KAFKA_APPLICATIONS_PASSWORD=
KAFKA_REVIEW_PASSWORD=
KAFKA_AUTH_PASSWORD=
KAFKA_NOTIFIER_PASSWORD=

# ---------- Токены (политика токенов, п. 2 ЛР3) ----------
# Закрытый ключ RSA-2048 (PKCS#8 PEM, base64 в одну строку). Есть только у auth-service:
# только он выпускает токены доступа.
JWT_PRIVATE_KEY_B64=
# Открытый ключ той же пары (X.509 PEM, base64). Нужен шлюзу и всем сервисам для
# самостоятельной проверки подписи (B-04: сервис не доверяет шлюзу).
JWT_PUBLIC_KEY_B64=

# ---------- Хранение паролей (п. 4.3 ЛР2) ----------
# Перец: общий секрет 32 байта (base64). Примешивается к паролю (HMAC-SHA256) до Argon2id.
# Хранится вне базы: утечка одного дампа БД не позволяет вести перебор.
PASSWORD_PEPPER_B64=
# Пароль тестовых учётных записей из db/seed.sql. При первом запуске auth-service
# вычисляет для них Argon2id-хеш с перцем. Пустое значение — тестовые пароли не задаются.
DEMO_USERS_PASSWORD=

# ---------- Каталог учётных записей R-09 (локальная заглушка OpenLDAP, B-13) ----------
LDAP_ADMIN_PASSWORD=
# Учётная запись только для чтения, под которой сервисы сверяют статус обучающегося.
LDAP_READONLY_PASSWORD=

# ---------- Объектное хранилище вложений (B-03/B-07) ----------
# Административный ключ хранилища (создание бакета при инициализации).
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
# Ключ applications-service: права только на бакет вложений.
S3_APPLICATIONS_ACCESS_KEY=
S3_APPLICATIONS_SECRET_KEY=

# ---------- Почтовая заглушка R-08 (Mailpit, B-14) ----------
# Учётные данные интеграции notifier → SMTP.
SMTP_USER=
SMTP_PASSWORD=

# ---------- Межсервисный вызов notifier → auth-service ----------
# Сервисный токен: auth-service отдаёт контакт получателя только вызывающему с этим токеном.
NOTIFIER_SERVICE_TOKEN=
